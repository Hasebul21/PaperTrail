# PostgreSQL connection string (use Vercel Postgres, Neon, Supabase, or any Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/papertrail?schema=public"

# NextAuth / Auth.js
# Generate via: openssl rand -base64 32
AUTH_SECRET="replace-with-strong-random-string"
# Used by Auth.js for cookie domain in production
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob storage token (read+write). In Vercel projects it's injected as BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=""

# Public URL of the app (used for canonical links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
