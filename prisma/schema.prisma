generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum NoteType {
  BOOK
  PAGE
  HIGHLIGHT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  books      Book[]
  progress   ReadingProgress[]
  highlights Highlight[]
  notes      Note[]
  bookmarks  Bookmark[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id                 String     @id @default(cuid())
  userId             String
  title              String
  fileName           String
  fileUrl            String
  fileKey            String
  mimeType           String     @default("application/pdf")
  size               Int        @default(0)
  totalPages         Int?
  currentPage        Int        @default(1)
  progressPercentage Float      @default(0)
  status             BookStatus @default(NOT_STARTED)
  uploadedAt         DateTime   @default(now())
  lastOpenedAt       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress   ReadingProgress?
  highlights Highlight[]
  notes      Note[]
  bookmarks  Bookmark[]

  @@index([userId])
  @@index([userId, lastOpenedAt])
}

model ReadingProgress {
  id                 String   @id @default(cuid())
  userId             String
  bookId             String   @unique
  currentPage        Int      @default(1)
  totalPages         Int?
  progressPercentage Float    @default(0)
  lastReadAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Highlight {
  id           String   @id @default(cuid())
  userId       String
  bookId       String
  pageNumber   Int
  selectedText String   @db.Text
  color        String   @default("yellow")
  rects        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  book  Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([bookId, pageNumber])
  @@index([userId])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  bookId      String
  pageNumber  Int?
  highlightId String?
  type        NoteType @default(PAGE)
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  highlight Highlight? @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([bookId, pageNumber])
  @@index([userId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  pageNumber Int
  label      String?
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
}
